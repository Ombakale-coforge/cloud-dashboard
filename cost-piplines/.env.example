# =======================================================
# 1. SERVER & AUTH (REQUIRED IN PRODUCTION)
# =======================================================
PORT=3001

# Required when NODE_ENV=production (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_character_random_secret
# Session lifetime in hours (default: 8)
JWT_TTL_HOURS=8

# Admin account bootstrapped into dbo.users on seed/start (password is hashed)
ADMIN_EMAIL=dashboard-admin@coforge.com
ADMIN_PASSWORD=replace_with_strong_password
# Optional: comma-separated additional admin emails
# ADMIN_EMAILS=admin2@coforge.com

# Optional: force Secure cookies on/off. When unset, auto-detects HTTPS / X-Forwarded-Proto: https.
# Do NOT set to true when serving over plain HTTP (browsers will drop cd_session cookies).
# COOKIE_SECURE=true

# =======================================================
# 2. DATABASE — SQL SERVER / PRISMA 7 (REQUIRED)
# =======================================================
# Used by PrismaMssql, Prisma CLI (prisma7.config.ts), and all ingestion/report scripts.
# Format must include host:port and semicolon-delimited params:
DATABASE_URL="sqlserver://HOST:1433;database=YOUR_DB;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

# Optional DB timeout tuning (milliseconds; defaults: 60000 / 30000)
# DB_REQUEST_TIMEOUT_MS=60000
# DB_CONNECTION_TIMEOUT_MS=30000

# Dev-only (used by `prisma migrate dev`, NOT needed in production `prisma migrate deploy`)
# SHADOW_DATABASE_URL="sqlserver://localhost:11433;database=PrismaShadow;user=sa;password=YourStrongPassword123!;encrypt=false;trustServerCertificate=true"

# =======================================================
# 3. AWS COST EXPLORER & BUDGETS (REQUIRED FOR AWS)
# =======================================================
# Primary AWS Account
AWS_ACCESS_KEY_ID=your_aws_account_1_access_key
AWS_SECRET_ACCESS_KEY=your_aws_account_1_secret_key
AWS_REGION=us-east-1
AWS_ACCOUNT_NAME=AWS Account 1 (Primary)
# Optional: override payer account ID used in executive PDF reports
# AWS_PAYER_ACCOUNT_ID=

# Optional: Secondary AWS Account
AWS_ACCOUNT_2_ACCESS_KEY_ID=
AWS_ACCOUNT_2_SECRET_ACCESS_KEY=
AWS_ACCOUNT_2_REGION=us-east-1
AWS_ACCOUNT_2_NAME=AWS Account 2

# Output folder & lookback window
AWS_COST_OUTPUT_FOLDER=./AWSReports
AWS_COST_MONTHS_HISTORY=6

# =======================================================
# 4. AZURE FOCUS EXPORT, ARM BUDGETS & GRAPH (REQUIRED FOR AZURE)
# =======================================================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=

# Optional Azure ingestion & analytics overrides
# AZURE_EXPORT_PREFIX=finops_dir/CFfinopexport-focus-cost/
# MONTHS_BACK=6
# ANOMALY_THRESHOLD_PERCENT=15
# ANOMALY_ROLLING_MONTHS=3
# deploy.sh passes this rate to VITE_AZURE_USD_TO_INR_RATE during Vite build so UI, emails, and PDFs stay in sync
AZURE_USD_TO_INR_RATE=84

# =======================================================
# 5. GOOGLE CLOUD PLATFORM / BIGQUERY (REQUIRED FOR GCP)
# =======================================================
GCP_PROJECT_NAME=your_gcp_project_name
GCP_PROJECT_ID=your_gcp_project_id
GCP_BIGQUERY_DATASET=your_billing_dataset_id
GCP_DATASET_LOCATION=US
# Path to service account JSON key file on server (or use GCP_SERVICE_ACCOUNT_JSON inline)
GCP_KEY_FILE=./credentials/gcp-service-account.json
# Optional GCP overrides
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_BIGQUERY_BILLING_TABLE=
# GCP_BILLING_ACCOUNT_ID=
# GCP_CURRENCY=INR
# GCP_MONTHLY_BUDGET=
# GCP_PROJECT_BUDGETS=

# =======================================================
# 6. EMAIL DELIVERY — REPORTS, BUDGETS & BURST ALERTS (REQUIRED)
# =======================================================
# Comma-separated manager recipients for daily executive reports
ALERT_EMAIL_TO=manager1@company.com,manager2@company.com

# Transport A (Preferred if AZURE_* app has Mail.Send permission): Microsoft Graph
SENDER_EMAIL=finops-alerts@company.com

# Transport B (SMTP fallback, or when --smtp is passed)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=finops-alerts@company.com

# Optional alert pipeline mode (preview | send; default: preview)
# EMAIL_MODE=send
# LOG_LEVEL=info

# Daily Ops Logging & Email Audit Digest (runs daily at 10:00 AM via PM2)
# Comma-separated recipients (supports multiple emails, e.g. a@co.com,b@co.com); falls back to ADMIN_EMAIL if unset
LOG_DIGEST_EMAIL_TO=
# Number of days to retain local audit & raw pipeline logs under logs/audit/ (default: 14)
LOG_RETENTION_DAYS=14

# =======================================================
# 7. OPTIONAL FEATURES (SET ONLY IF USED)
# =======================================================
# Azure AD SSO (defaults to AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET)
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_REDIRECT_URI=https://your-server-domain.com/api/auth/azure/callback

# Built-in Node HTTPS (skip if Nginx / Caddy / ALB terminates TLS)
# SSL_PFX_PATH=./certs/server.pfx
# SSL_PASSPHRASE=
# HTTPS_PORT=443

# Headless browser binary for executive PDF rendering (auto-detects chromium/chrome/msedge)
# BROWSER_PATH=/usr/bin/chromium

#Azure Daily Cost-Burst Alert tuning (defaults: 10% of prev month, ₹500 / $10 floor, 1-day lag)
AZURE_BURST_FALLBACK_EMAIL=cloud.support@coforge.com
AZURE_BURST_CC_EMAIL=cloud.support@coforge.com
AZURE_BURST_THRESHOLD_PERCENT=10
AZURE_BURST_MIN_COST_INR=10000
AZURE_BURST_MIN_COST_USD=100
AZURE_BURST_DATA_LAG_DAYS=1

# FinOps AI Chatbot (falls back to built-in knowledge base if unset)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_MONTHLY_CAP_USD=10
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
