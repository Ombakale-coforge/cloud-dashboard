# =======================================================
# AWS Credentials & Multi-Account Settings
# =======================================================

# --- AWS Account 1 (Primary Account) ---
AWS_ACCESS_KEY_ID=your_aws_account_1_access_key
AWS_SECRET_ACCESS_KEY=your_aws_account_1_secret_key
AWS_REGION=us-east-1
AWS_ACCOUNT_NAME=AWS Account 1 (Primary)

# --- AWS Account 2 (Secondary Account) ---
AWS_ACCOUNT_2_ACCESS_KEY_ID=your_aws_account_2_access_key
AWS_ACCOUNT_2_SECRET_ACCESS_KEY=your_aws_account_2_secret_key
AWS_ACCOUNT_2_REGION=us-east-1
AWS_ACCOUNT_2_NAME=AWS Account 2

# Output & Months History
AWS_COST_OUTPUT_FOLDER=./AWSReports
AWS_COST_MONTHS_HISTORY=6

#Cloudflare secrets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
AZURE_COST_R2_PREFIX=

#Cloudflare azure bucket secrets
R2_AZURE_DATA_ACCOUNT_ID=
R2_AZURE_DATA_ACCESS_KEY_ID=
R2_AZURE_DATA_SECRET_ACCESS_KEY=
R2_AZURE_DATA_BUCKET_NAME=

#Azure credentials
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

#SMTP CONFIG-
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

#DB
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=
HOST=

#SHADOW DB FOR DEV ENV
#Note - use the docker compose yml to start up a shadow db container.
SHADOW_DATABASE_URL="sqlserver://localhost:11433;database=PrismaShadow;user=sa;password=YourStrongPassword123!;encrypt=false;trustServerCertificate=true"

#AUTH
# Required in production (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime in hours (default 8)
JWT_TTL_HOURS=8
# Admin account is created/updated in dbo.users on server start (password is hashed).
ADMIN_EMAIL=dashboard-admin@coforge.com
ADMIN_PASSWORD=8iieb9gb
# Comma-separated list of browser origins allowed to call the API (default http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Optional: restrict self-signup to these email domains, e.g. coforge.com
ALLOWED_SIGNUP_DOMAINS=
# Optional: force Secure cookies on/off (defaults to on when NODE_ENV=production)
COOKIE_SECURE=
# Optional: set to 1 when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=




