# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file - it's already excluded in .gitignore.

# --- Required: AWS credentials ---
# Prefer a scoped IAM user/role limited to:
#   ce:GetCostAndUsage
#   organizations:ListAccounts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Folder where CSV reports are written (relative or absolute path).
AWS_COST_OUTPUT_FOLDER=./AWSReports

# How many months of history to pull each run.
AWS_COST_MONTHS_HISTORY=6