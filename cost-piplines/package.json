{
  "name": "aws-cost-pipeline",
  "version": "1.0.0",
  "description": "Pulls AWS Cost Explorer data, computes cost insights, and exports CSVs for Power BI.",
  "main": "src/aws_cost_pipeline.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/aws_cost_pipeline.ts",
    "report": "tsx src/aws_cost_pipeline.ts",
    "seed:aws": "tsx src/aws_cost_report/index.ts",
    "report:aws": "tsx src/aws_cost_pipeline.ts",
    "server": "tsx src/server/index.ts",
    "ingest:focus": "tsx src/fetch_data/focus-export/index.ts",
    "test:focus": "tsx src/fetch_data/focus-export/self-check.ts",
    "report:azure": "tsx src/azure_cost_report/index.ts",
    "test:report": "tsx src/azure_cost_report/self-check.ts",
    "alert:azure": "tsx src/alerts/index.ts",
    "test:alerts": "tsx src/alerts/self-check.ts",
    "sync:azure-budgets": "tsx src/fetch_data/sync-azure-budgets.ts",
