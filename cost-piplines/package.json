    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.15",
    "winston": "^3.19.0"
  },
  "devDependencies": {
