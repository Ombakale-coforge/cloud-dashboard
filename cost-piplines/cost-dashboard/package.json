{
  "name": "cost-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.js",
    "server": "node server.js",
    "dev:vite": "vite",
    "dev": "npm run sync-data && concurrently -k -p \"[{name}]\" -n \"API,VITE\" -c \"cyan,magenta\" \"node server.js\" \"vite\"",
