// schema.prisma
// -------------------------------------------------------
// Prisma schema for SQL Server. R2/AWS is gone entirely — Azure Blob
// (source) and SQL Server (sink) are the only two systems in this
// pipeline now.
//
// Changes made in this revision:
//
// 1. Prisma 7 removed the datasource `url` property from schema files
//    entirely — connection config for Migrate/CLI now lives in
//    prisma.config.ts (see that file), and PrismaClient itself takes a
//    driver adapter instance at construction time rather than reading
//    DATABASE_URL implicitly. See ingest-focus-export.js's `adapter`
//    setup and prisma.config.ts alongside this schema.
//
// 2. IngestionRun.period / .runId renamed to exportPeriod / exportRunId,
//    and the model itself renamed IngestionRun -> AzureIngestionRun
//    (table azure_ingestion_runs) — see point 7 below.
//
// 3. azure_usage_records_date_meter_idx was recomputed against SQL Server's
//    900-byte nonclustered index key limit. Worst case with the
//    inherited MySQL-style NVarChar(191) widths was ~959 bytes — over
//    the limit. NVarChar(191) came from MySQL/InnoDB's utf8mb4 index
//    prefix cap (767 bytes / 4), which doesn't apply here at all.
//    subscriptionId and meterId actually hold short Azure IDs, so both
//    are right-sized to NVarChar(100), and consumedUnit was dropped
//    from this one composite index (still a plain column, just not
//    part of this key). New worst case: ~467 bytes.
//
// 4. No native `enum` type — status fields are plain String with
//    allowed values documented in comments, enforced at the app layer.
//
// 5. No native `Json` type — usageRecords.tags and reportRuns.monthsCovered
//    are String columns holding JSON text. The app must
//    JSON.stringify() before writing and JSON.parse() after reading —
//    Prisma will NOT do this for you the way it might for a native Json
//    column on providers that support one.
//
// 6. SQL Server hard limits that the ingest script chunks around:
//      - max ~2,100 parameters per query
//      - max 1,000 rows per multi-row INSERT
//    Neither limit is expressed in this schema file — see
//    ingest-focus-export.js's computeInsertChunkSize().
//
// 7. Every model is prefixed Azure* (and every mapped table/index name
//    azure_*): AzureIngestionRun / azure_ingestion_runs and
//    AzureUsageRecord / azure_usage_records hold data sourced directly
//    from Azure; the eighteen AzureReport* / azure_report_* tables are
//    computed downstream of azure_usage_records rather than sourced
//    from Azure directly, but they're written by the same pipeline and
//    back the same Azure FinOps dashboard, so they carry the same
//    prefix rather than a separate naming scheme.
//
// Everything else (dedup/supersede design, report-table shape) is
// unchanged from the MySQL/Drizzle version.

datasource db {
  provider = "sqlserver"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------
// azure_ingestion_runs — append-only log of every Azure Cost
// Management FOCUS export run processed. Prefixed azure_ since this
// table (unlike the report_* tables further down) holds data sourced
// directly from Azure. status is a plain String
// ("started" | "success" | "failed") — see file header point 4.
// ---------------------------------------------------------------
model AzureIngestionRun {
  id                 BigInt   @id @default(autoincrement()) @map("id")

  /// The Azure export's period folder, e.g. "2026-09" — one per
  /// calendar month, per the FOCUS export layout.
  exportPeriod       String   @map("export_period") @db.NVarChar(64)

  /// The Azure export's own runId, taken from its blob path
  /// (<prefix>/<exportPeriod>/<exportRunId>/...). For an open month
  /// Azure assigns a new one on every MonthToDate re-export.
  exportRunId        String   @map("export_run_id") @db.NVarChar(191)

  /// Allowed values: "started" | "success" | "failed". Enforced in
  /// application code, not by the database — see file header point 4.
  status             String   @default("started") @map("status") @db.NVarChar(16)
  errorMessage       String?  @map("error_message") @db.NVarChar(1024)

  ingestedAt         DateTime @default(now()) @map("ingested_at")
  rowsParsed         Int      @default(0) @map("rows_parsed")
  rowsWritten        Int      @default(0) @map("rows_written")
  duplicatesFlagged  Int      @default(0) @map("duplicates_flagged")
  supersedesFlagged  Int      @default(0) @map("supersedes_flagged")

  usageRecords       AzureUsageRecord[]

  @@unique([exportPeriod, exportRunId], map: "azure_ingestion_runs_period_run_unique")
  @@index([exportPeriod], map: "azure_ingestion_runs_period_idx")
  @@map("azure_ingestion_runs")
}

// ---------------------------------------------------------------
// azure_usage_records — one row per FOCUS charge line. Prefixed
// azure_ since this table holds data sourced directly from Azure
// (unlike the report_* tables further down, which are computed
// downstream from this one). Dedup/supersede design unchanged:
// stableRowHash detects an exact re-delivery of the same row;
// chargeKeyHash identifies "the same underlying charge" independent
// of cost, so a revised amount for an already-ingested charge
// supersedes the old row instead of duplicating or overwriting it.
// See ingest-focus-export.js for the full mechanism.
// ---------------------------------------------------------------
model AzureUsageRecord {
  id                      BigInt    @id @default(autoincrement()) @map("id")

  stableRowHash           String    @map("stable_row_hash") @db.Char(64)
  chargeKeyHash           String    @map("charge_key_hash") @db.Char(64)
  isDuplicateOfEarlierRow Boolean   @default(false) @map("is_duplicate_of_earlier_row")
  isSupersededByLaterRow  Boolean   @default(false) @map("is_superseded_by_later_row")

  usageDate               DateTime  @map("usage_date") @db.Date
  usageMonth              String    @map("usage_month") @db.Char(7)
  chargePeriodStart       DateTime? @map("charge_period_start")
  chargePeriodEnd         DateTime? @map("charge_period_end")

  // Immutable Azure subscription ID (FOCUS SubAccountId) only — never
  // fall back to subscriptionName here. Right-sized to NVarChar(100):
  // an Azure subscription ID is a 36-char GUID, and this column is
  // part of a composite index — see file header point 3.
  subscriptionId          String    @map("subscription_id") @db.NVarChar(100)
  subscriptionName        String?   @map("subscription_name") @db.NVarChar(255)

  // Nullable: FOCUS allows ResourceId to be null for charges not tied
  // to a resource (Purchases, Tax, some Adjustments).
  resourceId              String?   @map("resource_id") @db.NVarChar(300)
  resourceIdHash          String?   @map("resource_id_hash") @db.Char(64)
  resourceName            String?   @map("resource_name") @db.NVarChar(255)
  resourceGroup           String?   @map("resource_group") @db.NVarChar(255)

  service                 String    @map("service") @db.NVarChar(255)

  // Right-sized to NVarChar(100) — also part of a composite index,
  // see file header point 3. Azure meter IDs are GUIDs.
  meterId                 String?   @map("meter_id") @db.NVarChar(100)
  meterName               String?   @map("meter_name") @db.NVarChar(255)
  meterCategory           String?   @map("meter_category") @db.NVarChar(255)
  meterSubCategory        String?   @map("meter_sub_category") @db.NVarChar(255)

  consumedQuantity        Decimal?  @map("consumed_quantity") @db.Decimal(24, 6)
  consumedUnit            String?   @map("consumed_unit") @db.NVarChar(64)
  pricingQuantity         Decimal?  @map("pricing_quantity") @db.Decimal(24, 6)
  pricingUnit             String?   @map("pricing_unit") @db.NVarChar(64)

  billedCost              Decimal   @map("billed_cost") @db.Decimal(18, 6)
  effectiveCost           Decimal   @map("effective_cost") @db.Decimal(18, 6)
  billingCurrency         String    @default("INR") @map("billing_currency") @db.NVarChar(8)

  chargeType              String?   @map("charge_type") @db.NVarChar(64)
  chargeClass             String?   @map("charge_class") @db.NVarChar(32)
  region                  String?   @map("region") @db.NVarChar(128)
  pricingModel            String?   @map("pricing_model") @db.NVarChar(64)
  isCreditEligible        Boolean?  @map("is_credit_eligible")

  // JSON TEXT, not a native Json column — see file header point 5.
  // The app must JSON.stringify() the parsed tags object before
  // writing this field and JSON.parse() it back out on read.
  tags                    String?   @map("tags") @db.NVarChar(Max)
  tagsRaw                 String?   @map("tags_raw") @db.NVarChar(2048)

  isExcludedFromAlerts    Boolean   @default(false) @map("is_excluded_from_alerts")

  ingestionRunId          BigInt?   @map("ingestion_run_id")
  ingestionRun            AzureIngestionRun? @relation(fields: [ingestionRunId], references: [id])

  createdAt               DateTime  @default(now()) @map("created_at")

  @@index([stableRowHash], map: "azure_usage_records_stable_hash_idx")
  @@index([chargeKeyHash], map: "azure_usage_records_charge_key_hash_idx")
  @@index([usageDate, subscriptionId], map: "azure_usage_records_date_sub_idx")
  @@index([usageDate, service], map: "azure_usage_records_date_service_idx")
  @@index([usageDate, subscriptionId, resourceIdHash], map: "azure_usage_records_date_resource_idx")
  // consumedUnit dropped from this key vs. the earlier draft — see
  // file header point 3 for the byte-length math.
  @@index([usageDate, subscriptionId, resourceIdHash, meterId], map: "azure_usage_records_date_meter_idx")
  @@index([resourceIdHash, usageDate], map: "azure_usage_records_resource_seen_idx")
  @@index([usageMonth], map: "azure_usage_records_usage_month_idx")
  @@index([ingestionRunId], map: "azure_usage_records_ingestion_run_idx")
  @@index([isDuplicateOfEarlierRow, isSupersededByLaterRow, isExcludedFromAlerts, usageDate], map: "azure_usage_records_active_alerts_idx")
  @@map("azure_usage_records")
}

// ---------------------------------------------------------------
// azure_report_runs — append-only log of every reporting pipeline run.
// Also prefixed azure_: these are computed downstream of
// azure_usage_records, but they're written by the same pipeline and
// serve the same Azure FinOps dashboard, so they get the same prefix.
// Same started/success/failed tracking as AzureIngestionRun, same
// reason: a failed refresh must never be mistaken for a completed one.
//
// NOTE (still unaddressed — not part of this pass): none of the
// AzureReport* tables below carry an actual @relation to this model —
// reportRunId is a plain Int on each with no FK enforcement. Worth
// revisiting if you want Prisma to enforce/traverse that relationship
// when the report-generation script gets its own Prisma rewrite.
// ---------------------------------------------------------------
model AzureReportRun {
  id                      Int      @id @default(autoincrement()) @map("id")
  runStamp                String   @map("run_stamp") @db.NVarChar(32)

  /// Allowed values: "started" | "success" | "failed".
  status                  String   @default("started") @map("status") @db.NVarChar(16)

  startedAt               DateTime @default(now()) @map("started_at")
  completedAt             DateTime? @map("completed_at")
  durationMs              Int?     @map("duration_ms")
  dedupedRowCount         BigInt?  @map("deduped_row_count")

  // JSON text (array of "YYYY-MM" strings) — see file header point 5.
  monthsCovered           String?  @map("months_covered") @db.NVarChar(Max)

  anomalyThresholdPercent Decimal? @map("anomaly_threshold_percent") @db.Decimal(6, 2)
  anomalyRollingMonths    Int?     @map("anomaly_rolling_months")
  errorMessage            String?  @map("error_message") @db.NVarChar(1024)
  logText                 String?  @map("log_text") @db.NVarChar(Max)

  @@index([runStamp], map: "azure_report_runs_run_stamp_idx")
  @@map("azure_report_runs")
}

model AzureReportMonthlyTotals {
  id           Int    @id @default(autoincrement()) @map("id")
  reportRunId  Int    @map("report_run_id")
  month        String @map("month") @db.Char(7)
  totalCost    Decimal @map("total_cost") @db.Decimal(18, 2)

  @@index([month], map: "azure_report_monthly_totals_month_idx")
  @@map("azure_report_monthly_totals")
}

model AzureReportKpisByMonth {
  id                    Int      @id @default(autoincrement()) @map("id")
  reportRunId           Int      @map("report_run_id")
  month                 String   @map("month") @db.Char(7)
  totalCost             Decimal  @map("total_cost") @db.Decimal(18, 2)
  topSubscription       String?  @map("top_subscription") @db.NVarChar(255)
  topSubscriptionCost   Decimal? @map("top_subscription_cost") @db.Decimal(18, 2)
  topService            String?  @map("top_service") @db.NVarChar(255)
  topServiceCost        Decimal? @map("top_service_cost") @db.Decimal(18, 2)
  subscriptions         Int      @default(0) @map("subscriptions")
  resourceGroups        Int      @default(0) @map("resource_groups")

  @@index([month], map: "azure_report_kpis_by_month_month_idx")
  @@map("azure_report_kpis_by_month")
}

model AzureReportBySubscription {
  id           Int     @id @default(autoincrement()) @map("id")
  reportRunId  Int     @map("report_run_id")
  month        String  @map("month") @db.Char(7)
  subscription String  @map("subscription") @db.NVarChar(255)
  cost         Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "azure_report_by_subscription_month_idx")
  @@map("azure_report_by_subscription")
}

model AzureReportByResourceGroup {
  id            Int     @id @default(autoincrement()) @map("id")
  reportRunId   Int     @map("report_run_id")
  month         String  @map("month") @db.Char(7)
  resourceGroup String  @map("resource_group") @db.NVarChar(255)
  subscription  String  @map("subscription") @db.NVarChar(255)
  cost          Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "azure_report_by_resource_group_month_idx")
  @@map("azure_report_by_resource_group")
}

model AzureReportByService {
  id               Int     @id @default(autoincrement()) @map("id")
  reportRunId      Int     @map("report_run_id")
  month            String  @map("month") @db.Char(7)
  consumedService  String  @map("consumed_service") @db.NVarChar(255)
  cost             Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "azure_report_by_service_month_idx")
  @@map("azure_report_by_service")
}

model AzureReportByChargeType {
  id           Int     @id @default(autoincrement()) @map("id")
  reportRunId  Int     @map("report_run_id")
  month        String  @map("month") @db.Char(7)
  chargeType   String  @map("charge_type") @db.NVarChar(64)
  cost         Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "azure_report_by_charge_type_month_idx")
  @@map("azure_report_by_charge_type")
