  month        String  @map("month") @db.Char(7)
  region       String  @map("region") @db.NVarChar(128)
  cost         Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "report_by_region_month_idx")
  @@map("report_by_region")
}

model ReportByPricingModel {
  id            Int     @id @default(autoincrement()) @map("id")
  reportRunId   Int     @map("report_run_id")
  month         String  @map("month") @db.Char(7)
  pricingModel  String  @map("pricing_model") @db.NVarChar(64)
  cost          Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "report_by_pricing_model_month_idx")
  @@map("report_by_pricing_model")
}

model ReportCreditEligibility {
  id             Int     @id @default(autoincrement()) @map("id")
  reportRunId    Int     @map("report_run_id")
  month          String  @map("month") @db.Char(7)
  creditEligible String  @map("credit_eligible") @db.NVarChar(16)
  cost           Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "report_credit_eligibility_month_idx")
  @@map("report_credit_eligibility")
}

model ReportTopMeters {
  id             Int     @id @default(autoincrement()) @map("id")
  reportRunId    Int     @map("report_run_id")
  month          String  @map("month") @db.Char(7)
  meter          String  @map("meter") @db.NVarChar(255)
  category       String  @map("category") @db.NVarChar(255)
  service        String  @map("service") @db.NVarChar(255)
  resourceGroup  String  @map("resource_group") @db.NVarChar(255)
  cost           Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "report_top_meters_month_idx")
  @@map("report_top_meters")
}

model ReportMomChange {
  id                 Int      @id @default(autoincrement()) @map("id")
  reportRunId        Int      @map("report_run_id")
  month              String   @map("month") @db.Char(7)
  totalCost          Decimal  @map("total_cost") @db.Decimal(18, 2)
  previousMonthCost  Decimal? @map("previous_month_cost") @db.Decimal(18, 2)
  momPercentChange   Decimal? @map("mom_percent_change") @db.Decimal(10, 2)

  @@index([month], map: "report_mom_change_month_idx")
  @@map("report_mom_change")
}

model ReportCostConcentrationPareto {
  id                  Int     @id @default(autoincrement()) @map("id")
  reportRunId         Int     @map("report_run_id")
  service             String  @map("service") @db.NVarChar(255)
  totalCost           Decimal @map("total_cost") @db.Decimal(18, 2)
  percentOfTotal      Decimal @map("percent_of_total") @db.Decimal(6, 2)
  cumulativePercent   Decimal @map("cumulative_percent") @db.Decimal(6, 2)
  rank                Int     @map("rank")

  @@map("report_cost_concentration_pareto")
}

model ReportAnomalyFlags {
  id                 Int      @id @default(autoincrement()) @map("id")
  reportRunId        Int      @map("report_run_id")
  month              String   @map("month") @db.Char(7)
  totalCost          Decimal  @map("total_cost") @db.Decimal(18, 2)
  rollingAvg         Decimal? @map("rolling_avg") @db.Decimal(18, 2)
  differencePercent  Decimal? @map("difference_percent") @db.Decimal(10, 2)
  thresholdPercent   Decimal  @map("threshold_percent") @db.Decimal(6, 2)
  isAnomaly          Boolean  @default(false) @map("is_anomaly")

  @@index([month], map: "report_anomaly_flags_month_idx")
  @@map("report_anomaly_flags")
}

model ReportNewServicesByMonth {
  id           Int    @id @default(autoincrement()) @map("id")
  reportRunId  Int    @map("report_run_id")
  month        String @map("month") @db.Char(7)
  newService   String @map("new_service") @db.NVarChar(255)

  @@index([month], map: "report_new_services_by_month_month_idx")
  @@map("report_new_services_by_month")
}

model ReportForecastNextMonth {
  id                    Int     @id @default(autoincrement()) @map("id")
  reportRunId           Int     @map("report_run_id")
  method                String  @map("method") @db.NVarChar(64)
  forecastedTotalCost   Decimal @map("forecasted_total_cost") @db.Decimal(18, 2)

  @@map("report_forecast_next_month")
}

model ReportVolatility {
  id                              Int     @id @default(autoincrement()) @map("id")
  reportRunId                     Int     @map("report_run_id")
  service                         String  @map("service") @db.NVarChar(255)
  mean                            Decimal @map("mean") @db.Decimal(18, 2)
  stdDev                          Decimal @map("std_dev") @db.Decimal(18, 2)
  coefficientOfVariationPercent   Decimal @map("coefficient_of_variation_percent") @db.Decimal(10, 1)

  @@map("report_volatility")
}

model ReportTopResources {
  id             Int     @id @default(autoincrement()) @map("id")
  reportRunId    Int     @map("report_run_id")
  month          String  @map("month") @db.Char(7)
  resourceName   String  @map("resource_name") @db.NVarChar(255)
  resourceGroup  String  @map("resource_group") @db.NVarChar(255)
  service        String  @map("service") @db.NVarChar(255)
  cost           Decimal @map("cost") @db.Decimal(18, 2)

  @@index([month], map: "report_top_resources_month_idx")
  @@map("report_top_resources")
}
